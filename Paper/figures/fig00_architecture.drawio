        <!-- Phase 1: DGI pill -->
        <mxCell id="gap3DGIPill"
                value="Phase 1: Deep Graph Infomax Pre-training  (unsupervised)"
                style="rounded=1;whiteSpace=wrap;html=1;
                       fillColor=#ffe6cc;strokeColor=#d79b00;
                       fontStyle=1;fontSize=10.5;fontColor=#7a4800;align=center;"
                parent="gap3" vertex="1">
          <mxGeometry x="12" y="38" width="425" height="28" as="geometry"/>
        </mxCell>

        <mxCell id="gap3DGIContent"
                value="2-layer GCN encoder:  H⁽¹⁾ = ELU(Â X W₁),  Z = ELU(Â H⁽¹⁾ W₂) ∈ ℝᴺˣ¹²⁸&lt;br&gt;
Global summary: s = σ(mean z_v)  •  Bilinear discriminator: D(z_i, s) = z_iᵀ W s&lt;br&gt;
Binary cross-entropy: real pairs vs. row-shuffled corrupted pairs&lt;br&gt;
Uses all 203,769 nodes (incl. 157,205 unlabelled) — fully transductive"
                style="text;html=1;strokeColor=none;fillColor=none;
                       align=left;verticalAlign=top;spacingLeft=6;
                       whiteSpace=wrap;fontSize=9;"
                parent="gap3" vertex="1">
          <mxGeometry x="12" y="74" width="426" height="66" as="geometry"/>
        </mxCell>

        <!-- Phase 2: GAT pill -->
        <mxCell id="gap3GATPill"
                value="Phase 2: GAT Fine-tuning  (supervised, 46,564 labelled nodes)"
                style="rounded=1;whiteSpace=wrap;html=1;
                       fillColor=#ffe6cc;strokeColor=#d79b00;
                       fontStyle=1;fontSize=10.5;fontColor=#7a4800;align=center;"
                parent="gap3" vertex="1">
          <mxGeometry x="12" y="148" width="425" height="28" as="geometry"/>
        </mxCell>

        <mxCell id="gap3GATContent"
                value="Layer 1: 8-head concat attention → H₁ ∈ ℝᴺˣ¹²⁸  (ELU, dropout 0.6)&lt;br&gt;
Layer 2: 1-head mean attention → H₂ ∈ ℝᴺˣ¹²⁸&lt;br&gt;
Fused representation: H_fused = [H₂ ‖ Z*] ∈ ℝᴺˣ²⁵⁶&lt;br&gt;
MLP classifier  •  class-weighted CE:  w₁ = 4.317,  w₀ = 0.565&lt;br&gt;
ADASYN oversampling (diagnostic only)  •  threshold θ* = 0.9397"
                style="text;html=1;strokeColor=none;fillColor=none;
                       align=left;verticalAlign=top;spacingLeft=6;
                       whiteSpace=wrap;fontSize=9;"
                parent="gap3" vertex="1">
          <mxGeometry x="12" y="184" width="426" height="78" as="geometry"/>
        </mxCell>

        <mxCell id="gap3Div" value=""
                style="line;strokeColor=#9673a6;fillColor=none;
                       strokeWidth=0.8;dashed=1;dashPattern=4 3;"
                parent="gap3" vertex="1">
          <mxGeometry x="12" y="266" width="426" height="4" as="geometry"/>
        </mxCell>

        <mxCell id="gap3Results"
                value="&lt;i&gt;&lt;b&gt;Results (Elliptic test set, time steps 42–49):&lt;/b&gt;&lt;/i&gt;&lt;br&gt;
• Illicit F1 = 0.7337   (RF 0.628, GAT-only 0.204, KNN 0.483)&lt;br&gt;
• ROC-AUC = 0.9868  •  Bootstrap 95% CI: (0.674, 0.793)&lt;br&gt;
• DGI pre-training contributes +36 pp to F1  (ablation confirmed)"
