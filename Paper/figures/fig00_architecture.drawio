                parent="gap1" vertex="1">
          <mxGeometry x="12" y="250" width="419" height="4" as="geometry"/>
        </mxCell>

        <mxCell id="gap1ImplNote"
                value="&lt;i&gt;Implementation note:&lt;/i&gt;&lt;br&gt;
k-d tree built on 30k subsample; cluster labels propagated&lt;br&gt;
to remaining 5.85M nodes via nearest-centroid assignment"
                style="text;html=1;strokeColor=none;fillColor=none;
