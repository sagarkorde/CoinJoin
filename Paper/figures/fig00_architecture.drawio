                parent="gap1" vertex="1">
          <mxGeometry x="12" y="164" width="419" height="4" as="geometry"/>
        </mxCell>

        <mxCell id="gap1Results"
                value="&lt;i&gt;&lt;b&gt;Results (pre-Taproot proxy evaluation):&lt;/b&gt;&lt;/i&gt;&lt;br&gt;
• FPR: 3.72% → 0.75%  (−79.8% relative reduction)&lt;br&gt;
• Precision: 0.770 → 0.833&lt;br&gt;
• FNR: 70.0%  (conservative; Taproot indistinguishability)&lt;br&gt;
• &gt;5,200 false positives eliminated per 200k transactions"
                style="text;html=1;strokeColor=none;fillColor=none;
                       align=left;verticalAlign=top;spacingLeft=6;
                       whiteSpace=wrap;fontSize=9;fontStyle=2;"
                parent="gap1" vertex="1">
