                       startSize=28;fillColor=#e1d5e7;strokeColor=#9673a6;
                       fontColor=#ffffff;fontSize=10.5;"
                parent="parallelGroup" vertex="1">
          <mxGeometry x="465" y="22" width="443" height="500" as="geometry"/>
        </mxCell>

        <mxCell id="gap2Pill"
                value="Multi-Dimensional Chamfer Distance (MD-CD)"
                style="rounded=1;whiteSpace=wrap;html=1;
                       fillColor=#f8cecc;strokeColor=#b85450;
                       fontStyle=1;fontSize=10.5;fontColor=#7d1f1f;align=center;"
                parent="gap2" vertex="1">
          <mxGeometry x="60" y="38" width="323" height="28" as="geometry"/>
        </mxCell>

        <mxCell id="gap2Content"
                value="&lt;b&gt;4-dim feature vector φ(t) ∈ ℝ⁴:&lt;/b&gt;&lt;br&gt;
[timestamp, fee_rate, input_count, output_count]&lt;br&gt;
Min-max normalisation → one-sided Chamfer distance:&lt;br&gt;
  d_C(U,V) = (1/|U|) Σ min ‖u_i − v_j‖₂&lt;br&gt;
Optimal threshold θ* determined by F1 maximisation"
                style="text;html=1;strokeColor=none;fillColor=none;
                       align=left;verticalAlign=top;spacingLeft=6;
                       whiteSpace=wrap;fontSize=9;"
                parent="gap2" vertex="1">
          <mxGeometry x="12" y="82" width="419" height="82" as="geometry"/>
        </mxCell>

        <mxCell id="gap2Div1" value=""
                style="line;strokeColor=#9673a6;fillColor=none;
                       strokeWidth=0.8;dashed=1;dashPattern=4 3;"
                parent="gap2" vertex="1">
          <mxGeometry x="12" y="168" width="419" height="4" as="geometry"/>
        </mxCell>

        <mxCell id="gap2Results"
                value="&lt;i&gt;&lt;b&gt;Results (author-curated corpus, 5.88M transactions):&lt;/b&gt;&lt;/i&gt;&lt;br&gt;
• Recall &gt; 0.954  (identical for 1-D and 4-D MD variants)&lt;br&gt;
• F1 difference = −0.006  (no measurable gain from extra dims)&lt;br&gt;
• Temporal clustering dominates; MD extension adds no signal&lt;br&gt;
• Boundary condition: 1-D timestamp sufficient for this corpus"
                style="text;html=1;strokeColor=none;fillColor=none;
                       align=left;verticalAlign=top;spacingLeft=6;
                       whiteSpace=wrap;fontSize=9;fontStyle=2;"
                parent="gap2" vertex="1">
