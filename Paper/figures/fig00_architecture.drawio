          <mxGeometry x="70" y="38" width="303" height="28" as="geometry"/>
        </mxCell>

        <mxCell id="gap1Content"
                value="&lt;b&gt;6-dim feature vector ψ(t) ∈ ℝ⁶:&lt;/b&gt;&lt;br&gt;
[input_count, output_count, fee_rate,&lt;br&gt;
 value_concentration, address_reuse, mixing_index]&lt;br&gt;
Z-score standardisation → DBSCAN  (ε = 0.6, minPts = 5)&lt;br&gt;
k-d tree spatial index; 30k-node subsample → centroid propagation"
                style="text;html=1;strokeColor=none;fillColor=none;
                       align=left;verticalAlign=top;spacingLeft=6;
                       whiteSpace=wrap;fontSize=9;"
                parent="gap1" vertex="1">
