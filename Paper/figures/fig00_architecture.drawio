                parent="parallelGroup" vertex="1">
          <mxGeometry x="12" y="22" width="443" height="500" as="geometry"/>
        </mxCell>

        <mxCell id="gap1Pill" value="Structural DBSCAN Clustering"
                style="rounded=1;whiteSpace=wrap;html=1;
