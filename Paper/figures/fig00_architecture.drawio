        <!-- Eval box 1: Illicit Detection -->
        <mxCell id="evalBox1"
                value="&lt;b&gt;Illicit Detection (Elliptic)&lt;/b&gt;&lt;br&gt;
F1 = 0.734  |  ROC-AUC = 0.987&lt;br&gt;
